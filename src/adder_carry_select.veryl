/// Carry-select adder (CSA): the width is split into fixed-size blocks.
/// Each block speculatively computes its sum for carry-in 0 and 1, then
/// selects once the real block carry arrives. Trades area for shorter delay.
module AdderCarrySelect #(
    param WIDTH: u32 = 32,
    param BLK  : u32 = 4 , // block size (WIDTH must be a multiple of BLK)
) (
    i_clk : input  clock       ,
    i_rst : input  reset       ,
    i_a   : input  logic<WIDTH>,
    i_b   : input  logic<WIDTH>,
    i_cin : input  logic       ,
    o_sum : output logic<WIDTH>,
    o_cout: output logic       ,
) {
    const NB: u32 = WIDTH / BLK; // number of blocks

    var a  : logic<WIDTH>;
    var b  : logic<WIDTH>;
    var cin: logic       ;

    always_ff {
        if_reset {
            a   = 0;
            b   = 0;
            cin = 0;
        } else {
            a   = i_a;
            b   = i_b;
            cin = i_cin;
        }
    }

    var sum      : logic<WIDTH> ;
    var blk_carry: logic<NB + 1>; // carry into each block
    var s0       : logic<WIDTH> ; // speculative sum, block carry-in = 0
    var s1       : logic<WIDTH> ; // speculative sum, block carry-in = 1
    var carry0   : logic        ;
    var carry1   : logic        ;

    always_comb {
        blk_carry[0] = cin;
        for blk in 0..NB {
            // two speculative ripples inside the block
            carry0 = 0;
            carry1 = 1;
            for j in 0..BLK {
                s0[blk * BLK + j] = a[blk * BLK + j] ^ b[blk * BLK + j] ^ carry0;
                s1[blk * BLK + j] = a[blk * BLK + j] ^ b[blk * BLK + j] ^ carry1;
                carry0            = a[blk * BLK + j] & b[blk * BLK + j] | carry0
                    & (a[blk * BLK + j] ^ b[blk * BLK + j]);
                carry1            = a[blk * BLK + j] & b[blk * BLK + j] | carry1
                    & (a[blk * BLK + j] ^ b[blk * BLK + j]);
            }
            // real block carry-out selects between the two speculations
            blk_carry[blk + 1] = if blk_carry[blk] ? carry1 : carry0;
            for k in 0..BLK {
                sum[blk * BLK + k] = if blk_carry[blk] ? s1[blk * BLK + k] : s0[blk * BLK + k];
            }
        }
    }

    always_ff {
        if_reset {
            o_sum  = 0;
            o_cout = 0;
        } else {
            o_sum  = sum;
            o_cout = blk_carry[NB];
        }
    }
}

/// Native-simulator functional check (run with `veryl test`).
/// Holds each vector stable for 2 clocks (input reg + output reg) and compares
/// {cout, sum} against a golden a + b + cin computed in `g`.
#[test(test_adder_carry_select)]
module test_adder_carry_select {
    const W : u32 = 32;
    const W1: u32 = 33;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var a   : logic<W> ;
    var b   : logic<W> ;
    var cin : logic    ;
    var sum : logic<W> ;
    var cout: logic    ;
    var g   : logic<W1>;

    inst dut: AdderCarrySelect ( i_clk: clk, i_rst: rst, i_a: a, i_b: b, i_cin: cin, o_sum: sum, o_cout: cout );

    always_comb {
        g = (a as W1) + (b as W1) + (cin as W1);
    }

    initial {
        a          = 0;
        b          = 0;
        cin        = 0;
        rst.assert();
        clk.next  (2);

        a        = 32'hffff_ffff;
        b        = 32'hffff_ffff;
        cin      = 1;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'hffff_ffff;
        b        = 32'd1;
        cin      = 0;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'h8000_0000;
        b        = 32'h8000_0000;
        cin      = 0;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'h1234_5678;
        b        = 32'h8765_4321;
        cin      = 1;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'hdead_beef;
        b        = 32'h0bad_f00d;
        cin      = 0;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        $finish();
    }
}

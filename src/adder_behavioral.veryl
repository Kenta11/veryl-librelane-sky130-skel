/// Behavioral adder: let the synthesizer choose the implementation.
/// Inputs and outputs are registered so the timing/power comparison
/// measures a clean register-to-register path.
module AdderBehavioral #(
    param WIDTH: u32 = 32,
) (
    i_clk : input  clock       ,
    i_rst : input  reset       ,
    i_a   : input  logic<WIDTH>,
    i_b   : input  logic<WIDTH>,
    i_cin : input  logic       ,
    o_sum : output logic<WIDTH>,
    o_cout: output logic       ,
) {
    // registered inputs
    var a  : logic<WIDTH>;
    var b  : logic<WIDTH>;
    var cin: logic       ;

    always_ff {
        if_reset {
            a   = 0;
            b   = 0;
            cin = 0;
        } else {
            a   = i_a;
            b   = i_b;
            cin = i_cin;
        }
    }

    // combinational addition (WIDTH+1 bits to capture carry-out)
    const W1     : u32       = WIDTH + 1;
    var   sum_ext: logic<W1>;
    always_comb {
        sum_ext = (a as W1) + (b as W1) + (cin as W1);
    }

    // registered outputs
    always_ff {
        if_reset {
            o_sum  = 0;
            o_cout = 0;
        } else {
            o_sum  = sum_ext[WIDTH - 1:0];
            o_cout = sum_ext[WIDTH];
        }
    }
}

/// Native-simulator functional check (run with `veryl test`).
/// Holds each vector stable for 2 clocks (input reg + output reg) and compares
/// {cout, sum} against a golden a + b + cin computed in `g`.
#[test(test_adder_behavioral)]
module test_adder_behavioral {
    const W : u32 = 32;
    const W1: u32 = 33;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var a   : logic<W> ;
    var b   : logic<W> ;
    var cin : logic    ;
    var sum : logic<W> ;
    var cout: logic    ;
    var g   : logic<W1>;

    inst dut: AdderBehavioral ( i_clk: clk, i_rst: rst, i_a: a, i_b: b, i_cin: cin, o_sum: sum, o_cout: cout );

    always_comb {
        g = (a as W1) + (b as W1) + (cin as W1);
    }

    initial {
        a          = 0;
        b          = 0;
        cin        = 0;
        rst.assert();
        clk.next  (2);

        a        = 32'hffff_ffff;
        b        = 32'hffff_ffff;
        cin      = 1;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'hffff_ffff;
        b        = 32'd1;
        cin      = 0;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'h8000_0000;
        b        = 32'h8000_0000;
        cin      = 0;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'h1234_5678;
        b        = 32'h8765_4321;
        cin      = 1;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        a        = 32'hdead_beef;
        b        = 32'h0bad_f00d;
        cin      = 0;
        clk.next(2);
        $assert (sum == g[W - 1:0] && cout == g[W]);

        $finish();
    }
}
